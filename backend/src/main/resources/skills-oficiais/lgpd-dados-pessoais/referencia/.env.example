# origem: skills-modelo/.env.example
# Ambiente de DESENVOLVIMENTO da API. Copie para .env (nunca versionado) e ajuste.
# Toda variável do schema (apps/api/src/config/config.ts) aparece aqui: definida ou comentada com "# ".
# Qualquer variável também pode vir de arquivo: NOME_ARQUIVO=/caminho (ex.: DATABASE_URL_ARQUIVO=/run/secrets/db_url).

# development | test | production. Deixe definida: sem ela o login funciona como em produção (cookie só em https).
NODE_ENV=development
# Porta HTTP da API (o Vite, em http://localhost:5173, encaminha /api para cá).
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Postgres 16 local (docker compose up -d postgres). Tem senha: em produção use DATABASE_URL_ARQUIVO.
DATABASE_URL=postgres://app:app@localhost:5432/app

# Versão e commit: no Docker vêm dos build-args da imagem. Em dev ficam "dev" e "desconhecido".
# APP_VERSAO=dev
# APP_COMMIT=desconhecido

# Pasta do build da web para a API servir o SPA. Em dev, deixe comentada e use o Vite (pnpm dev).
# WEB_DIST=../web/dist

# Segurança (apps/api/src/seguranca/).
# Origens de OUTROS sites que podem chamar a API com cookie, separadas por vírgula. Vazia: CORS desligado
# (o Vite em dev encaminha /api, então front e API ficam na mesma origem).
# CORS_ORIGENS=https://painel.exemplo.com.br
# Requisições por minuto por IP em /api; acima disso, 429 com Retry-After.
# LIMITE_REQ_POR_IP=300
# Proxies confiáveis na frente da API (0 em dev; 1 atrás do Caddy na instalação).
# PROXIES_CONFIAVEIS=0

# E-mail (apps/api/src/email/). Em dev o Mailpit do docker compose recebe tudo: docker compose up -d mailpit,
# e a caixa de entrada fica em http://localhost:8025. log = só registra no log (nada é enviado); smtp = envia.
MAIL_MODE=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# true = TLS direto (porta 465); false = STARTTLS quando o servidor oferece (587, 25, Mailpit).
# SMTP_SEGURO=false
# O Mailpit não pede login. Num SMTP de verdade, use SMTP_USUARIO e SMTP_SENHA (em produção, SMTP_SENHA_ARQUIVO).
# SMTP_USUARIO=
# SMTP_SENHA=
EMAIL_REMETENTE=Sistema <nao-responda@exemplo.com.br>

# Usuários e papéis (apps/api/src/usuarios/).
# Primeiro administrador: se não houver nenhum ADMIN ativo, a API cria (ou reativa) este usuário como ADMIN ao subir.
ADMIN_INICIAL_EMAIL=admin@exemplo.com.br
# Nome do sistema nos e-mails (convite). Uma linha, até 80 caracteres.
# NOME_SISTEMA=Sistema

# Login por código no e-mail (apps/api/src/auth/).
# Domínios de e-mail que podem pedir código, separados por vírgula (exatos). Vazia: qualquer domínio cadastrado.
# AUTH_DOMINIOS_PERMITIDOS=exemplo.com.br
# Chave do HMAC dos códigos (mínimo 32 caracteres; gere com: openssl rand -hex 32). Em dev pode ficar comentada: a API
# gera uma por processo (os códigos pendentes deixam de valer ao reiniciar). Em produção é obrigatória.
# AUTH_SEGREDO_CODIGO=
# A sessão expira parada por estes minutos ou estas horas depois do login, o que vier primeiro.
# AUTH_SESSAO_OCIOSA_MIN=30
# AUTH_SESSAO_ABSOLUTA_H=12

# Trilha de auditoria (apps/api/src/auditoria/): papel de banco SÓ de runtime, sem UPDATE/DELETE na trilha. A migração cria o
# papel app_runtime (sem login). Em dev, depois de pnpm --filter api db:migrate, dê login e senha de desenvolvimento:
#   docker compose exec postgres psql -U app -d app -c "ALTER ROLE app_runtime LOGIN PASSWORD 'app_runtime'"
# e descomente a linha abaixo. DATABASE_URL (o dono) fica só para as migrações. Sem ela a API usa o dono, e isso só é aceito com NODE_ENV=development (acima); o usuário tem de ser outro que o de DATABASE_URL.
# DATABASE_URL_RUNTIME=postgres://app_runtime:app_runtime@localhost:5432/app

# Dados pessoais / LGPD (apps/api/src/lgpd/). Chaves da criptografia de campo (AES-256-GCM): kid:base64 separadas por vírgula,
# 32 bytes cada; a PRIMEIRA cifra, as outras só decifram (rotação). E a chave do índice cego (HMAC), diferente das de dados.
# Gere cada uma com: openssl rand -base64 32   (ou: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Em dev podem ficar comentadas: a API gera chaves por processo, mas o que for cifrado não abre depois de reiniciar (gere uma
# vez e descomente). Em produção são obrigatórias (DADOS_CHAVES_ARQUIVO / DADOS_CHAVE_INDICE_ARQUIVO).
# DADOS_CHAVES=k1:COLE_AQUI_32_BYTES_EM_BASE64
# DADOS_CHAVE_INDICE=COLE_AQUI_OUTROS_32_BYTES_EM_BASE64
# Retenção (pnpm --filter api lgpd:retencao): dias depois do encerramento até anonimizar o cliente e apagar códigos e sessões
# velhos. Vazia: nada é expurgado (o prazo é decisão do jurídico/DPO, registrada no CLAUDE.md).
# RETENCAO_DIAS=1825
# Idade (dias) do evento de auditoria cujo IP o mesmo comando apaga, conectando como o DONO (DATABASE_URL). Vazia: trilha intacta.
# RETENCAO_AUDITORIA_IP_DIAS=730
