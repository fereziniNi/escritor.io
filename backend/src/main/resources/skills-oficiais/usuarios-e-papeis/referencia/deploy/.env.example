# origem: skills-modelo/deploy/.env.example
# Instalação no servidor do cliente (Docker Compose). Copie para deploy/.env e preencha.
# Toda variável do schema da API (apps/api/src/config/config.ts) aparece aqui: definida ou comentada com "# ".
# Segredos: prefira arquivo (NOME_ARQUIVO=/run/secrets/nome) a valor em texto no .env.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Obrigatória. Use o arquivo de segredo montado pelo compose:
# DATABASE_URL_ARQUIVO=/run/secrets/database_url
# ou, se não houver segredo em arquivo, a URL direta:
# DATABASE_URL=postgres://app:TROCAR@postgres:5432/app

# Preenchidas no build da imagem (não mexer no servidor):
# APP_VERSAO=1.0.0
# APP_COMMIT=abc1234

# A imagem já traz o build da web nesta pasta; a API serve o SPA.
WEB_DIST=/app/web

# Segurança. O Caddy fica na frente da API: 1 proxy confiável (IP real, https e host corretos).
# Sem isso o limite por IP vale para o Caddy inteiro e a checagem de origem recusa os POST.
# Com 1, a API confia no X-Forwarded-For que recebe: ela NÃO pode publicar porta no host (nada de "ports:" no
# serviço da API) e só pode ser alcançada pelo Caddy, cujo reverse_proxy reescreve o X-Forwarded-For.
PROXIES_CONFIAVEIS=1
# Requisições por minuto por IP em /api (escritórios atrás de um único IP: aumente).
LIMITE_REQ_POR_IP=300
# Só se outro sistema, em outro endereço, chamar esta API pelo navegador (lista separada por vírgula):
# CORS_ORIGENS=https://painel.exemplo.com.br

# E-mail. Em produção MAIL_MODE=smtp é obrigatório (log é recusado no boot). Peça servidor, usuário e senha à TI do cliente.
MAIL_MODE=smtp
# SMTP_HOST=smtp.exemplo.com.br
# 587 com STARTTLS (SMTP_SEGURO=false) ou 465 com TLS direto (SMTP_SEGURO=true).
SMTP_PORT=587
SMTP_SEGURO=false
# SMTP_USUARIO=apikey
# SMTP_SENHA_ARQUIVO=/run/secrets/smtp_senha
# SMTP_SENHA=
# EMAIL_REMETENTE=Sistema <nao-responda@exemplo.com.br>

# Usuários e papéis. Informe o e-mail da primeira administradora: ao subir, se não houver nenhum ADMIN ativo, a API
# cria esse usuário como ADMIN (depois disso a variável não faz mais nada).
# ADMIN_INICIAL_EMAIL=admin@exemplo.com.br
# Nome do sistema nos e-mails de convite. Uma linha, até 80 caracteres.
# NOME_SISTEMA=Sistema
