# Não commitado (ver .gitignore) - só nesta máquina, porque outro projeto local ("cambia") já usa
# 5432/8080/5173/1025/8025. Ver DEVELOPMENT.md "Troubleshooting".
POSTGRES_PORT=5432
BACKEND_PORT=8082
FRONTEND_PORT=5175
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026
EVOLUTION_HABILITADO=true
EVOLUTION_CHEFE_NUMERO=<REDIGIDO: numero de whatsapp do chefe>

# Integração com Google Agenda (ver DEVELOPMENT.md "Integração com Google Agenda") - credenciais
# geradas pelo próprio usuário no Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=<REDIGIDO: gerar no Google Cloud Console>
GOOGLE_OAUTH_CLIENT_SECRET=<REDIGIDO: gerar no Google Cloud Console>
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5175/integracoes/google/callback
GOOGLE_TOKEN_CHAVE_CRIPTO=<REDIGIDO: openssl rand -base64 32>
# Auditoria de seguranca (VULN-01, CRITICAL, ver relatorio) - segredo de assinatura do JWT.
# Gerado localmente com `openssl rand -base64 64`; obrigatorio (docker-compose.yml usa ${JWT_SEGREDO:?...}).
# NUNCA versionar - trocar este valor invalida todas as sessoes ativas.
JWT_SEGREDO=<REDIGIDO: openssl rand -base64 64>
