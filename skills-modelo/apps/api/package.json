{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/banco/executar-migracoes.ts",
    "fila:migrar": "tsx src/fila/executar-migracao-fila.ts",
    "lgpd:retencao": "tsx src/lgpd/executar-lgpd.ts retencao",
    "lgpd:recifrar": "tsx src/lgpd/executar-lgpd.ts recifrar"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@aws-sdk/client-s3": "3.1163.0",
    "@aws-sdk/lib-storage": "3.1163.0",
    "@aws-sdk/s3-request-presigner": "3.1163.0",
    "@azure/storage-blob": "12.34.0",
    "@fontsource/inter": "5.3.0",
    "@langfuse/otel": "6.1.1",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "busboy": "1.6.0",
    "contratos": "workspace:*",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.3.1",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "pg-boss": "11.1.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.22",
    "@testcontainers/azurite": "12.2.1",
    "@testcontainers/minio": "12.2.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/busboy": "1.5.5",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "pdfjs-dist": "6.5.438",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
