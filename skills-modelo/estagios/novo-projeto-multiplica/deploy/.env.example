# Instalação no servidor do cliente (Docker Compose). Copie para deploy/.env e preencha.
# Toda variável do schema da API (apps/api/src/config/config.ts) aparece aqui: definida ou comentada com "# ".
# Segredos: prefira arquivo (NOME_ARQUIVO=/run/secrets/nome) a valor em texto no .env.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Obrigatória. Use o arquivo de segredo montado pelo compose:
# DATABASE_URL_ARQUIVO=/run/secrets/database_url
# ou, se não houver segredo em arquivo, a URL direta:
# DATABASE_URL=postgres://app:TROCAR@postgres:5432/app

# Preenchidas no build da imagem (não mexer no servidor):
# APP_VERSAO=1.0.0
# APP_COMMIT=abc1234

# A imagem já traz o build da web nesta pasta; a API serve o SPA.
WEB_DIST=/app/web
